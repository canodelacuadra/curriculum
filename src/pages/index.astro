---
import '../styles/global.css';
import curriculum from '../data/curriculum.json';
import Icon from '../components/Icon.astro';
---


<!DOCTYPE html>
<html lang="es">
 <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Basic Meta Tags -->
    <title>{curriculum.personal.nombre} - Desarrollador Web Full Stack & Formador | Curriculum Vitae</title>
    <meta name="description" content="Desarrollador Web con más de 10 años de experiencia en formación y desarrollo. Especializado en React, Node.js, JavaScript, TypeScript, PHP. Formador Ocupacional y Profesor Universitario." />
    <meta name="keywords" content="desarrollador web, full stack, formador ocupacional, profesor, react, node.js, javascript, typescript, php, curriculum, jose antonio cano" />
    <meta name="author" content="{curriculum.personal.nombre}" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://canodelacuadra.github.io/curriculum/" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{curriculum.personal.nombre} - Desarrollador Web Full Stack & Formador" />
    <meta property="og:description" content="Desarrollador Web con más de 10 años de experiencia en formación y desarrollo. Especializado en React, Node.js, JavaScript, TypeScript." />
    <meta property="og:image" content={`${import.meta.env.SITE}${import.meta.env.BASE_URL}/img/jose-cano.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Foto de {curriculum.personal.nombre}" />
    <meta property="og:url" content="https://canodelacuadra.github.io/curriculum/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Curriculum Vitae - {curriculum.personal.nombre}" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{curriculum.personal.nombre} - Desarrollador Web Full Stack & Formador" />
    <meta name="twitter:description" content="Desarrollador Web con más de 10 años de experiencia en formación y desarrollo. Especializado en React, Node.js, JavaScript, TypeScript." />
    <meta name="twitter:image" content={`${import.meta.env.SITE}${import.meta.env.BASE_URL}/img/jose-cano.jpg`} />
    <meta name="twitter:image:alt" content="Foto de {curriculum.personal.nombre}" />
    <meta name="twitter:creator" content="@canodelacuadra" />
    
    <!-- Additional Meta Tags -->
    <meta name="language" content="Spanish" />
    <meta name="geo.region" content="ES-CM" />
    <meta name="geo.placename" content="La Puebla de Montalbán, Toledo" />
    <meta name="ICBM" content="39.8513,-4.1068" />
    
    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "{curriculum.personal.nombre}",
      "jobTitle": ["Desarrollador Web Full Stack", "Formador Ocupacional", "Profesor"],
      "description": "Desarrollador Web con más de 10 años de experiencia en formación ocupacional y universitaria. Especializado en tecnologías frontend y backend.",
      "url": "https://canodelacuadra.github.io/curriculum/",
      "image": `${import.meta.env.SITE}${import.meta.env.BASE_URL}/img/jose-cano.jpg`,
      "email": "{curriculum.personal.contacto.email}",
      "telephone": "{curriculum.personal.contacto.movil}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{curriculum.personal.contacto.calle}",
        "addressLocality": "{curriculum.personal.contacto.ciudad}",
        "addressCountry": "ES"
      },
      "knowsAbout": ["HTML5", "CSS3", "JavaScript", "TypeScript", "React", "Node.js", "Express.js", "PHP", "MySQL", "MongoDB", "Python"],
      "sameAs": [
        "{curriculum.redes.github}",
        "{curriculum.redes.linkedin}"
      ],
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Universidad Complutense de Madrid"
      },
      "worksFor": [
        {
          "@type": "Organization",
          "name": "Grupo CDM-Alcorcón"
        },
        {
          "@type": "Organization", 
          "name": "Grupo Aspasia-Adalid"
        }
      ]
    }
    </script>
    <link rel="shortcut icon" href={`${import.meta.env.BASE_URL}img/icon.png`} type="image/png">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
</head>
<body>
    <div class="container">
        <header>
            <div class="profile-photo">
                <img src={`${import.meta.env.BASE_URL}${curriculum.personal.foto.src}`} alt={curriculum.personal.foto.alt} />
            </div>
            <h1>{curriculum.personal.nombre}</h1>
            <p>Desarrollador Web & Formador para el Empleo</p>
            <div class="social-icons">
                <a href={curriculum.redes.github} target="_blank">
                    <Icon name="github" size="xl" />
                </a>
                <a href={curriculum.redes.linkedin} target="_blank">
                    <Icon name="linkedin" size="xl" />
                </a>
            </div>
        </header>

       

        <!-- Navegación Tabs -->
        <nav class="tabs-nav">
            <a href="#formacion" class="tab-link">Formación</a>
            <a href="#experiencia" class="tab-link">Experiencia</a>
            <a href="#tecnologias" class="tab-link">Tecnologías</a>
        </nav>

        <!-- Contenido Tabs -->
        <main class="tabs-content">
             <!-- Resumen Profesional -->
        <section id = "perfil"class="resumen tab-content default">
            <h2>Perfil Profesional</h2>
            <div class="perfil-content">
                <p class="perfil-texto">
                    Desarrollador Web con más de 10 años de experiencia en formación ocupacional y universitaria. 
                    Especializado en tecnologías frontend y backend, con capacidad para diseñar e impartir contenidos formativos 
                    técnicos adaptados a las necesidades del mercado laboral.
                </p>
                <div class="contacto-destacado">
                    <div class="contacto-item">
                        <Icon contact="email" size="sm" />
                        <span>{curriculum.personal.contacto.email}</span>
                    </div>
                    <div class="contacto-item">
                        <Icon contact="phone" size="sm" />
                        <span>{curriculum.personal.contacto.movil}</span>
                    </div>
                    <div class="contacto-item">
                        <Icon contact="location" size="sm" />
                        <span>{curriculum.personal.contacto.calle}, {curriculum.personal.contacto.ciudad}</span>
                    </div>
                </div>
            </div>
        </section>
            <!-- Tab Formación -->
            <section id="formacion" class="tab-content ">
                <h2>Formación Académica</h2>
                {curriculum.formacion.map((item) => (
                    <div class="item">
                        <h4>{item.estudios}</h4>
                        <p class="empresa-fecha"><strong>{item.institucion}</strong> - {item.fecha}</p>
                        {item.observaciones && <p class="descripcion">{item.observaciones} </p>}
                        {item.duracion && <p class="extras">{item.duracion} {item.lugar}</p>}
                    </div>
                ))}
            </section>

            <!-- Tab Experiencia -->
            <section id="experiencia" class="tab-content">
                <h2>Experiencia Profesional</h2>
                
                <div class="experiencia-categoria">
                    <h3>Formador Ocupacional</h3>
                    {curriculum.experiencia.formadorOcupacional.map((item) => (
                        <div class="item">
                            <h4>{item.cargo}</h4>
                            <p class="empresa-fecha"><strong>{item.empresa}</strong> - {item.fecha}</p>
                            <p class="descripcion">{item.descripcion}</p>
                            {(item.horas || item.lugar || item.fechaDetallada || item.observaciones) && <p class="extras">{item.horas}{item.horas && ' horas'}{item.horas && (item.lugar || item.fechaDetallada || item.observaciones) && ' | '}{item.lugar}{item.lugar && (item.fechaDetallada || item.observaciones) && ' | '}{item.fechaDetallada}{item.fechaDetallada && item.observaciones && ' | '}{item.observaciones}</p>}
                        </div>
                    ))}
                </div>

                <div class="experiencia-categoria">
                    <h3>Profesor Universitario</h3>
                    {curriculum.experiencia.profesorUniversitario.map((item) => (
                        <div class="item">
                            <h4>{item.cargo}</h4>
                            <p class="empresa-fecha"><strong>{item.empresa}</strong> - {item.fecha}</p>
                            <p class="descripcion">{item.descripcion}</p>
                            <p class="extras">{item.duracion} | {item.observaciones}</p>
                        </div>
                    ))}
                </div>

                <div class="experiencia-categoria">
                    <h3>Desarrollo Web</h3>
                    {curriculum.experiencia.desarrolloWeb.map((item) => (
                        <div class="item">
                            <h4>{item.cargo}</h4>
                            <p class="empresa-fecha"><strong>{item.empresa}</strong> - {item.fecha}</p>
                            <p class="descripcion">{item.descripcion}</p>
                            {item.observaciones && <p class="extras">{item.observaciones}</p>}
                        </div>
                    ))}
                </div>

                <div class="experiencia-categoria">
                    <h3>Diseño Gráfico</h3>
                    {curriculum.experiencia.disenoGrafico.map((item) => (
                        <div class="item">
                            <h4>{item.cargo}</h4>
                            <p class="empresa-fecha"><strong>{item.empresa}</strong> - {item.fecha}</p>
                            <p class="descripcion">{item.descripcion}</p>
                            {item.observaciones && <p class="extras">{item.observaciones}</p>}
                        </div>
                    ))}
                </div>

                <div class="experiencia-categoria">
                    <h3>Producción Audiovisual</h3>
                    {curriculum.experiencia.audiovisual.map((item) => (
                        <div class="item">
                            <h4>{item.cargo}</h4>
                            <p class="empresa-fecha"><strong>{item.empresa}</strong> - {item.fecha}</p>
                            <p class="descripcion">{item.descripcion}</p>
                            {item.observaciones && <p class="extras">{item.observaciones}</p>}
                        </div>
                    ))}
                </div>
            </section>

            <!-- Tab Tecnologías -->
            <section id="tecnologias" class="tab-content">
                <h2>Tecnologías y Herramientas</h2>
                <div class="tech-grid">
                    <!-- Lenguajes -->
                    <div class="tech-category">
                        <h3>Lenguajes</h3>
                        <div class="tech-items">
                            {curriculum.tecnologias.desarrolloWeb.lenguajes.map((tech) => (
                                <div class="tech-item">
                                    <Icon tech={tech} size="md" />
                                    <span>{tech}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Frameworks -->
                    <div class="tech-category">
                        <h3>Frameworks</h3>
                        <div class="tech-items">
                            {curriculum.tecnologias.desarrolloWeb.frameworks.map((tech) => (
                                <div class="tech-item">
                                    <Icon tech={tech} size="md" />
                                    <span>{tech}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Herramientas -->
                    <div class="tech-category">
                        <h3>Herramientas</h3>
                        <div class="tech-items">
                            {curriculum.tecnologias.desarrolloWeb.herramientas.map((tech) => (
                                <div class="tech-item">
                                    <Icon tech={tech} size="md" />
                                    <span>{tech}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Bases de Datos -->
                    <div class="tech-category">
                        <h3>Bases de Datos</h3>
                        <div class="tech-items">
                            {curriculum.tecnologias.desarrolloWeb.baseDatos.map((tech) => (
                                <div class="tech-item">
                                    <Icon tech={tech} size="md" />
                                    <span>{tech}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Expresión Audiovisual -->
                    <div class="tech-category">
                        <h3>Expresión Audiovisual</h3>
                        <div class="tech-items">
                            {[
                                ...curriculum.tecnologias.expresionAudiovisual.imagenRaster,
                                ...curriculum.tecnologias.expresionAudiovisual.imagenVectorial,
                                ...curriculum.tecnologias.expresionAudiovisual.video
                            ].map((tech) => (
                                <div class="tech-item">
                                    <Icon tech={tech} size="md" />
                                    <span>{tech}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <!-- Despliegue & Testing -->
                    <div class="tech-category">
                        <h3>Despliegue & Testing</h3>
                        <div class="tech-items">
                            {[
                                ...curriculum.tecnologias.desarrolloWeb.despliegue,
                                ...curriculum.tecnologias.desarrolloWeb.testing
                            ].map((tech) => (
                                <div class="tech-item">
                                    <Icon tech={tech} size="md" />
                                    <span>{tech}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <footer>
            <p>&copy; 2026 {curriculum.personal.nombre}. Todos los derechos reservados.</p>
        </footer>
    </div>
    
    <!-- Script para tabs con estado active -->
    <script is:inline src={`${import.meta.env.BASE_URL}scripts/tabs.js`}></script>
</body>
</html>