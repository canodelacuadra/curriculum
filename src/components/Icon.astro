// Función para obtener icono según tipo de contacto
function getIconForContact(contactType: string): string {
  const contactMap: Record<string, string> = {
    'email': 'fas fa-envelope',
    'phone': 'fas fa-phone',
    'location': 'fas fa-location-dot',
    'address': 'fas fa-location-dot',
    'tel': 'fas fa-phone',
    'mobile': 'fas fa-phone',
    'map': 'fas fa-map-marker',
    'marker': 'fas fa-map-marker'
  };
  
  return contactMap[contactType] || 'fas fa-question-circle';
}

