// Determinar qué clase de icono usar
let finalIconClass: string;
if (tech) {
  const iconName = getIconForTech(tech);
  finalIconClass = iconos[iconName as keyof typeof iconos] || 'fas fa-question-circle';
} else if (contact) {
  finalIconClass = getIconForContact(contact);
} else {
  const iconName = name || 'html5';
  finalIconClass = iconos[iconName as keyof typeof iconos] || 'fas fa-question-circle';
}

const sizes = {
  xs: 'fa-xs',
  sm: 'fa-sm',
  md: '',
  lg: 'fa-lg',
  xl: 'fa-xl',
  '2x': 'fa-2x',
  '3x': 'fa-3x'
};

const sizeClass = sizes[size as keyof typeof sizes] || '';
const finalClass = `${finalIconClass} ${sizeClass} ${className}`.trim();
---

<i class={finalClass} title={title} style={style}></i>