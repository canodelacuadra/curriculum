---
interface Props {
  name?: string;
  tech?: string;
  contact?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2x' | '3x';
  variant?: string;
  class?: string;
  style?: string;
  title?: string;
}

const { name, tech, contact, size = 'md', variant = 'outline', class: className = '', style = '', title = '' }: Props = Astro.props;

