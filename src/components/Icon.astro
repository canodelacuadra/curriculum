---
interface Props {
  name?: string;
  tech?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2x' | '3x';
  variant?: string;
  class?: string;
  style?: string;
  title?: string;
}

const { name, tech, size = 'md', variant = 'outline', class: className = '', style = '', title = '' }: Props = Astro.props;

// Determinar qué icono usar
const iconName = tech ? getIconForTech(tech) : (name || 'html5');

const iconos = {
  github: 'fab fa-github',
  linkedin: 'fab fa-linkedin-in',
  html5: 'fab fa-html5',
  css3: 'fab fa-css3-alt',
  javascript: 'fab fa-js',
  typescript: 'fab fa-js',
  python: 'fab fa-python',
  php: 'fab fa-php',
  sql: 'fas fa-database',
  react: 'fab fa-react',
  nodejs: 'fab fa-node-js',
  express: 'fas fa-server',
  bootstrap: 'fab fa-bootstrap',
  vite: 'fas fa-rocket',
  phaser: 'fas fa-gamepad',
  vscode: 'fas fa-code',
  git: 'fab fa-git-alt',
  npm: 'fab fa-npm',
  postgresql: 'fas fa-database',
  mysql: 'fas fa-database',
  mongodb: 'fas fa-database',
  vercel: 'fas fa-cloud-arrow-up',
  netlify: 'fas fa-cloud-arrow-up',
  'github-pages': 'fab fa-github',
  docker: 'fab fa-docker',
  jest: 'fas fa-vial',
  cypress: 'fas fa-vial',
  photoshop: 'fas fa-image',
  illustrator: 'fas fa-pen-nib',
  premiere: 'fas fa-film',
  aftereffects: 'fas fa-wand-magic-sparkles',
  figma: 'fab fa-figma'
};

// Función para obtener icono según nombre de tecnología
function getIconForTech(techName: string): string {
  const techMap: Record<string, string> = {
    'HTML5': 'html5',
    'CSS3': 'css3',
    'JavaScript': 'javascript',
    'TypeScript': 'typescript',
    'Python': 'python',
    'PHP': 'php',
    'SQL': 'sql',
    'HTTP': 'html5',
    'React': 'react',
    'Node.js': 'nodejs',
    'Express.js': 'express',
    'Bootstrap': 'bootstrap',
    'Vite': 'vite',
    'Phaser.js': 'phaser',
    'VS Code': 'vscode',
    'Git': 'git',
    'GitHub': 'github',
    'Terminal/Git Bash': 'git',
    'npm': 'npm',
    'PostgreSQL': 'postgresql',
    'MySQL': 'mysql',
    'MongoDB': 'mongodb',
    'Vercel': 'vercel',
    'Netlify': 'netlify',
    'GitHub Pages': 'github-pages',
    'Docker': 'docker',
    'Jest': 'jest',
    'Cypress': 'cypress',
    'Photoshop': 'photoshop',
    'Gimp': 'photoshop',
    'Pixlr': 'photoshop',
    'Adobe Illustrator': 'illustrator',
    'Corel Draw': 'illustrator',
    'Adobe Premiere': 'premiere',
    'After Effects': 'aftereffects',
    'Adobe InDesign': 'illustrator',
    'Scribus': 'illustrator',
    'Figma': 'figma'
  };
  
  return techMap[techName] || 'html5';
}

const sizes = {
  xs: 'fa-xs',
  sm: 'fa-sm',
  md: '',
  lg: 'fa-lg',
  xl: 'fa-xl',
  '2x': 'fa-2x',
  '3x': 'fa-3x'
};

const iconClass = iconos[iconName as keyof typeof iconos] || 'fas fa-question-circle';
const sizeClass = sizes[size as keyof typeof sizes] || '';
const finalClass = `${iconClass} ${sizeClass} ${className}`.trim();
---

<i class={finalClass} title={title} style={style}></i>