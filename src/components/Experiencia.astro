---
import curriculumData from '../content/curriculum.json';

const { experiencia } = curriculumData as any;

const experienciaTabs = [
  {
    id: 'formador',
    label: 'Formador Ocupacional',
    icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>',
    data: experiencia.formadorOcupacional
  },
  {
    id: 'universitario',
    label: 'Profesor Universitario',
    icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>',
    data: experiencia.profesorUniversitario
  },
  {
    id: 'fp',
    label: 'Profesor FP',
    icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>',
    data: experiencia.profesorFP
  },
  {
    id: 'web',
    label: 'Desarrollo Web',
    icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>',
    data: experiencia.desarrolloWeb
  },
  {
    id: 'diseno',
    label: 'Diseño Gráfico',
    icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>',
    data: experiencia.disenoGrafico
  },
  {
    id: 'audiovisual',
    label: 'Audiovisual',
    icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>',
    data: experiencia.audiovisual
  }
];

// Client-side JavaScript para tabs
const tabScript = `
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('[data-tab]');
    const panels = document.querySelectorAll('[data-panel]');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');
        
        // Remover estado activo de todos los tabs y paneles
        tabs.forEach(t => t.classList.remove('bg-blue-600', 'text-white'));
        tabs.forEach(t => t.classList.add('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300'));
        
        panels.forEach(panel => panel.classList.add('hidden'));
        
        // Activar tab y panel seleccionados
        tab.classList.remove('bg-gray-200', 'dark:bg-gray-700', 'text-gray-700', 'dark:text-gray-300');
        tab.classList.add('bg-blue-600', 'text-white');
        
        document.getElementById(targetId)?.classList.remove('hidden');
      });
    });
    
    // Activar primer tab por defecto
    if (tabs.length > 0) {
      tabs[0].click();
    }
  });
`;
---

<section id="experiencia" class="mb-16 scroll-mt-24 tech-grid">
  <div class="animate-fade-in-up">
    <!-- Título de la sección -->
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
        <svg class="inline-block w-8 h-8 mr-2 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
        </svg>
        Experiencia Profesional
      </h2>
      <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 mx-auto rounded-full"></div>
    </div>

    <!-- Tabs de navegación -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
      <!-- Tab buttons -->
      <div class="flex flex-wrap border-b border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
        {experienciaTabs.map((tab, index) => (
          <button
            data-tab={tab.id}
            class={`px-4 py-3 text-sm font-medium transition-colors duration-200 flex items-center space-x-2 border-b-2 border-transparent hover:border-blue-300 animate-fade-in-up`}
            style={`animation-delay: ${index * 0.05}s`}
            key={tab.id}
          >
            <set:html html={tab.icon} />
            <span class="hidden md:inline">{tab.label}</span>
            <span class="md:hidden">{tab.label.split(' ')[0]}</span>
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      <div class="p-6">
        {experienciaTabs.map((tab) => (
          <div 
            id={tab.id}
            data-panel
            class="hidden animate-fade-in-left"
            key={`panel-${tab.id}`}
          >
            <!-- Tabla de experiencia -->
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead class="glass-effect border-b border-gray-200 dark:border-gray-700">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                      Fecha
                    </th>
                    {tab.id === 'formador' && (
                      <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        Horas
                      </th>
                    )}
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                      Cargo
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                      Empresa
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                      Observaciones
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                  {tab.data.map((item: any, index: number) => (
                    <tr 
                      key={index}
                      class="hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors duration-200"
                    >
                      <td class="px-4 py-3 whitespace-nowrap">
                        <span class="text-sm font-medium text-gray-900 dark:text-gray-100">
                          {item.fecha}
                        </span>
                      </td>
                      {tab.id === 'formador' && (
                        <td class="px-4 py-3 whitespace-nowrap">
                          <span class="text-sm text-gray-600 dark:text-gray-400">
                            {item.horas}
                          </span>
                        </td>
                      )}
                      <td class="px-4 py-3">
                        <div>
                          <span class="text-sm font-medium text-gray-900 dark:text-gray-100">
                            {item.cargo}
                          </span>
                          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">
                            {item.descripcion}
                          </p>
                        </div>
                      </td>
                      <td class="px-4 py-3">
                        <span class="text-sm text-gray-900 dark:text-gray-100">
                          {item.empresa}
                        </span>
                      </td>
                      <td class="px-4 py-3">
                        <span class="text-xs text-gray-600 dark:text-gray-400">
                          {item.observaciones}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ tabScript }}>
  eval(tabScript);
</script>