---
import curriculumData from '../content/curriculum.json';

const { personal } = curriculumData as any;
---

<section id="datos" class="mb-16 scroll-mt-24 tech-grid">
  <div class="animate-fade-in-up">
    <!-- Título de la sección -->
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-green-500 to-emerald-600 mb-2">
        <svg class="inline-block w-8 h-8 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        Datos Personales
      </h2>
      <div class="w-32 h-1 bg-gradient-to-r from-green-500 to-emerald-600 mx-auto rounded-full relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/50 to-transparent animate-pulse"></div>
      </div>
    </div>

    <!-- Contenido de datos personales -->
    <div class="glass-effect rounded-lg shadow-xl p-6 md:p-8 hover-lift tech-border">
      <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        <!-- Información de contacto -->
        <div class="md:col-span-2 space-y-4">
          <!-- Dirección -->
          <div class="flex items-start space-x-3">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <div>
              <h3 class="font-semibold text-gray-900 dark:text-gray-100">Dirección</h3>
              <p class="text-gray-600 dark:text-gray-300">
                {personal.direccion.calle}<br />
                {personal.direccion.ciudad}
              </p>
            </div>
          </div>

          <!-- Contacto -->
          <div class="grid md:grid-cols-2 gap-4">
            <div class="flex items-center space-x-3">
              <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Teléfono</p>
                <p class="text-gray-900 dark:text-gray-100">
                  Móvil: {personal.direccion.movil}<br />
                  Fijo: {personal.direccion.fijo}
                </p>
              </div>
            </div>

            <div class="flex items-center space-x-3">
              <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Email</p>
                <a 
                  href={`mailto:${personal.contacto.email}`}
                  class="text-blue-600 dark:text-blue-400 hover:underline"
                >
                  {personal.contacto.email}
                </a>
              </div>
            </div>
          </div>

          <!-- Información personal -->
          <div class="grid md:grid-cols-2 gap-4 pt-4 border-t border-gray-200 dark:border-gray-700">
          <div class="flex items-center space-x-3">
            <div class="w-5 h-5 flex items-center justify-center">
              <div class="tech-dot"></div>
              <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Lugar de Nacimiento</p>
                <p class="text-gray-900 dark:text-gray-100">{personal.contacto.lugarNacimiento}</p>
              </div>
            </div>

            <div class="flex items-center space-x-3">
              <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Fecha de Nacimiento</p>
                <p class="text-gray-900 dark:text-gray-100">{personal.contacto.fechaNacimiento}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Foto -->
        <div class="flex justify-center md:justify-end">
          <div class="relative group">
            <img 
              src={personal.foto.src}
              alt={personal.foto.alt}
              class="w-48 h-48 md:w-56 md:h-56 rounded-lg shadow-lg object-cover transform transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>