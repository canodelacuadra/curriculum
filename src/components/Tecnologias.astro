---
import curriculumData from '../content/curriculum.json';

const { tecnologias } = curriculumData as any;
---

<section id="tecnologias" class="mb-16 scroll-mt-24 tech-grid">
  <div class="animate-fade-in-up">
    <!-- Título de la sección -->
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
        <svg class="inline-block w-8 h-8 mr-2 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        Tecnologías & Software
      </h2>
      <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-indigo-600 mx-auto rounded-full"></div>
    </div>

    <!-- Desarrollo Web -->
    <div class="mb-8">
      <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-6 text-center">
        Desarrollo Web
      </h3>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {Object.entries(tecnologias.desarrolloWeb).map(([category, items], categoryIndex) => {
          const getCategoryInfo = (cat: string) => {
            switch(cat) {
              case 'lenguajes': return {
                title: 'Lenguajes',
                icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>',
                gradient: 'from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20',
                borderColor: 'border-blue-200 dark:border-cyan-800',
                bgColor: 'bg-blue-600 dark:bg-blue-500',
                dotColor: 'bg-blue-400'
              };
              case 'frameworks': return {
                title: 'Frameworks',
                icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>',
                gradient: 'from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20',
                borderColor: 'border-green-200 dark:border-emerald-800',
                bgColor: 'bg-green-600 dark:bg-green-500',
                dotColor: 'bg-green-400'
              };
              case 'herramientas': return {
                title: 'Herramientas',
                icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>',
                gradient: 'from-purple-50 to-violet-50 dark:from-purple-900/20 dark:to-violet-900/20',
                borderColor: 'border-purple-200 dark:border-violet-800',
                bgColor: 'bg-purple-600 dark:bg-purple-500',
                dotColor: 'bg-purple-400'
              };
              case 'baseDatos': return {
                title: 'Bases de Datos',
                icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>',
                gradient: 'from-orange-50 to-amber-50 dark:from-orange-900/20 dark:to-amber-900/20',
                borderColor: 'border-orange-200 dark:border-amber-800',
                bgColor: 'bg-orange-600 dark:bg-orange-500',
                dotColor: 'bg-orange-400'
              };
              case 'despliegue': return {
                title: 'Despliegue',
                icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>',
                gradient: 'from-red-50 to-rose-50 dark:from-red-900/20 dark:to-rose-900/20',
                borderColor: 'border-red-200 dark:border-rose-800',
                bgColor: 'bg-red-600 dark:bg-red-500',
                dotColor: 'bg-red-400'
              };
              case 'testing': return {
                title: 'Testing',
                icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>',
                gradient: 'from-teal-50 to-cyan-50 dark:from-teal-900/20 dark:to-cyan-900/20',
                borderColor: 'border-teal-200 dark:border-cyan-800',
                bgColor: 'bg-teal-600 dark:bg-teal-500',
                dotColor: 'bg-teal-400'
              };
              case 'seguridad': return {
                title: 'Seguridad',
                icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>',
                gradient: 'from-indigo-50 to-blue-50 dark:from-indigo-900/20 dark:to-blue-900/20',
                borderColor: 'border-indigo-200 dark:border-blue-800',
                bgColor: 'bg-indigo-600 dark:bg-indigo-500',
                dotColor: 'bg-indigo-400'
              };
              case 'ia': return {
                title: 'IA Asistente',
                icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>',
                gradient: 'from-pink-50 to-rose-50 dark:from-pink-900/20 dark:to-rose-900/20',
                borderColor: 'border-pink-200 dark:border-rose-800',
                bgColor: 'bg-pink-600 dark:bg-pink-500',
                dotColor: 'bg-pink-400'
              };
              default: return {
                title: cat.charAt(0).toUpperCase() + cat.slice(1),
                icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>',
                gradient: 'from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20',
                borderColor: 'border-blue-200 dark:border-blue-800',
                bgColor: 'bg-blue-600 dark:bg-blue-500',
                dotColor: 'bg-blue-400'
              };
            }
          };

          const categoryInfo = getCategoryInfo(category);
          
          return (
            <div
              key={category}
              class={`glass-effect rounded-lg p-6 border ${categoryInfo.borderColor} hover-lift tech-border animate-fade-in-up`}
              style={`animation-delay: ${categoryIndex * 0.1}s`}
            >
              <div class="flex items-center mb-4">
                <div class={`${categoryInfo.bgColor} text-white p-2 rounded-lg`}
                  set:html={categoryInfo.icon}
                />
                <h4 class="ml-3 font-medium text-gray-900 dark:text-gray-100">
                  {categoryInfo.title}
                </h4>
              </div>
              <div class="space-y-2">
                {(items as string[]).map((item: string, index: number) => (
                  <div 
                    key={index}
                    class="flex items-center text-sm text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors duration-200"
                  >
                    <div class={`w-2 h-2 ${categoryInfo.dotColor} rounded-full mr-2`}></div>
                    {item}
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Expresión Audiovisual -->
    <div>
      <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-6 text-center">
        Expresión Audiovisual
      </h3>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {Object.entries(tecnologias.expresionAudiovisual).map(([category, items], categoryIndex) => (
          <div
            key={category}
            class="bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 rounded-lg p-6 border border-purple-200 dark:border-purple-800 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 animate-fade-in-up"
            style={`animation-delay: ${(categoryIndex + 4) * 0.1}s`}
          >
            <div class="flex items-center mb-4">
              <div class="bg-purple-600 dark:bg-purple-500 text-white p-2 rounded-lg">
                {
                  category === 'imagenRaster' ? 
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg> :
                  category === 'imagenVectorial' ? 
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg> :
                  category === 'maquetacion' ? 
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> :
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                }
              </div>
              <h4 class="ml-3 font-medium text-gray-900 dark:text-gray-100 capitalize">
                {category === 'imagenRaster' ? 'Imagen Ráster' :
                 category === 'imagenVectorial' ? 'Imagen Vectorial' :
                 category === 'maquetacion' ? 'Maquetación' :
                 'Video'}
              </h4>
            </div>
            <div class="space-y-2">
              {(items as string[]).map((item: string, index: number) => (
                <div 
                  key={index}
                  class="flex items-center text-sm text-gray-700 dark:text-gray-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors duration-200"
                >
                  <div class="w-2 h-2 bg-purple-400 rounded-full mr-2"></div>
                  {item}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>


      
     
    </div>
  </div>
</section>