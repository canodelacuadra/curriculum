---
import curriculumData from '../content/curriculum.json';

const { blogroll } = curriculumData as any;
---

<footer class="bg-gray-100 dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 mt-16">
  <div class="container mx-auto px-4 py-8">
    <!-- Blogroll -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4 text-center text-gray-900 dark:text-gray-100">Blogroll</h3>
      <div class="flex flex-wrap justify-center gap-2 md:gap-4">
        {blogroll.map((link: any, index: number) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors duration-200 underline-offset-2 hover:underline animate-fade-in-up"
            style={`animation-delay: ${index * 0.05}s`}
            key={link.nombre}
          >
            {link.nombre}
          </a>
        ))}
      </div>
    </div>

    <!-- Copyright -->
    <div class="text-center text-sm text-gray-600 dark:text-gray-400 border-t border-gray-200 dark:border-gray-700 pt-6">
      <p>&copy; {new Date().getFullYear()} José Antonio Cano de la Cuadra. Todos los derechos reservados.</p>
      <p class="mt-2 text-xs">
        Desarrollado con <span class="text-red-500">♥</span> usando Astro, TypeScript y Tailwind CSS
      </p>
    </div>
  </div>
</footer>